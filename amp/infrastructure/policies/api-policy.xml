<policies>
    <inbound>
        <base />
        <rate-limit-by-key calls="30" renewal-period="60" counter-key="@((context.Subscription?.Key ?? context.Request.IpAddress) + &quot;:slc&quot;)" />
        <choose>
            <when condition="@(context.Request.Headers.ContainsKey(&quot;Authorization&quot;))">
                <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Your JWT token failed CNP validation! " output-token-variable-name="extJwt">
                    <openid-config url="https://login.microsoftonline.com/${tenant_id}/v2.0/.well-known/openid-configuration" />
                    <audiences>
                        <audience>${client_id}</audience>
                    </audiences>
                    <issuers>
                        <issuer>https://login.microsoftonline.com/${tenant_id}/v2.0</issuer>
                    </issuers>
                    <required-claims>
                        <claim name="aud" match="any">
                            <value>${client_id}</value>
                        </claim>
                        <claim name="roles" match="any">
%{ for role in required_roles ~}
                            <value>${role}</value>
%{ endfor ~}
                        </claim>
                    </required-claims>
                </validate-jwt>
            </when>
            <otherwise>
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":"Missing CNP Authorization header."}</set-body>
                </return-response>
            </otherwise>
        </choose>
%{ if cp_audience != "" ~}
        <!-- CP token exchange (shared fragment from shared-platform-services-infra): swap the validated external token for a CP token. -->
        <set-variable name="cpAudience" value="${cp_audience}" />
%{ if length(cp_client_map) > 0 ~}
        <!-- This API's consumers: external client ID (azp) => that consumer's CP-access app. -->
        <choose>
%{ for ext_client_id, cp_app_id in cp_client_map ~}
            <when condition="@(((Jwt)context.Variables[&quot;extJwt&quot;]).Claims.GetValueOrDefault(&quot;azp&quot;, &quot;&quot;) == &quot;${ext_client_id}&quot;)">
                <set-variable name="cpAppId" value="${cp_app_id}" />
            </when>
%{ endfor ~}
        </choose>
%{ endif ~}
%{ if cp_reject_unmapped ~}
        <set-variable name="cpRejectUnmapped" value="@(true)" />
%{ endif ~}
        <!-- The cache policies stay here: cache-lookup-value is not supported inside a policy fragment. -->
        <choose>
            <when condition="@(!string.IsNullOrEmpty(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;cpAppId&quot;, &quot;&quot;)))">
                <cache-lookup-value key="@(&quot;cp-token-&quot; + (string)context.Variables[&quot;cpAppId&quot;] + &quot;-${cp_audience}&quot;)" variable-name="cpToken" />
            </when>
        </choose>
        <include-fragment fragment-id="cp-token-exchange" />
        <choose>
            <when condition="@(context.Variables.ContainsKey(&quot;cpTokenCacheSeconds&quot;))">
                <cache-store-value key="@(&quot;cp-token-&quot; + (string)context.Variables[&quot;cpAppId&quot;] + &quot;-${cp_audience}&quot;)" value="@((string)context.Variables[&quot;cpToken&quot;])" duration="@((int)context.Variables[&quot;cpTokenCacheSeconds&quot;])" />
            </when>
        </choose>
%{ endif ~}
        <quota-by-key calls="500" renewal-period="86400" counter-key="@((context.Subscription?.Key ?? context.Request.IpAddress) + &quot;:slc&quot;)" />
    </inbound>
    <backend>
        <limit-concurrency key="@((context.Subscription?.Key ?? context.Request.IpAddress) + &quot;:slc&quot;)" max-count="10">
            <forward-request />
        </limit-concurrency>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
